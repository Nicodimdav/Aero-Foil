def reset(event):
    for s in [s_speed, s_alt, s_angle, s_camber, s_thick, s_area]:
        s.reset()

btn_reset.on_clicked(reset)

def animate(frame):
    global particles_x, particles_y
    
    speed_kmh = s_speed.val
    angle_deg = s_angle.val
    camber_pct = s_camber.val
    thick_pct = s_thick.val
    
    v_base = (speed_kmh / 1200.0) * 0.022 + 0.005
    aoa_rad = np.radians(angle_deg)
    
    chord_zone = np.exp(-((particles_x - 0.35)**2) / 0.18)
    
    speed_change = np.zeros_like(particles_x)
    sin_aoa = np.sin(np.maximum(0, aoa_rad))
    speed_change[upper_mask] = (0.35 + 0.35 * sin_aoa) * chord_zone[upper_mask]
    speed_change[~upper_mask] = -(0.20 + 0.15 * sin_aoa) * chord_zone[~upper_mask]
    
    vx = v_base * (1.0 + speed_change * dist_decay)
    particles_x += vx

    t = max(0.01, thick_pct / 100.0)
    m = camber_pct / 100.0
    
    cos_aoa = np.cos(aoa_rad)
    sin_aoa_full = np.sin(aoa_rad)
    x_loc = (particles_x - 0.25) * cos_aoa + particles_y0 * sin_aoa_full + 0.25
    x_c = np.clip(x_loc, 0.001, 0.999)

    yt = 5 * t * (0.2969 * np.sqrt(x_c) - 0.1260 * x_c - 0.3516 * x_c**2 + 0.2843 * x_c**3 - 0.1015 * x_c**4)
    p = 0.4
    
    yc = np.empty_like(x_c)
    mask_p = x_c < p
    yc[mask_p] = (m / (p**2 + 1e-5)) * (2 * p * x_c[mask_p] - x_c[mask_p]**2)
    yc[~mask_p] = (m / ((1 - p)**2 + 1e-5)) * ((1 - 2 * p) + 2 * p * x_c[~mask_p] - x_c[~mask_p]**2)
    
    smooth_in = np.exp(-((x_loc - 0.0)**2) / 0.06) * (x_loc < 0)
    smooth_body = (x_loc >= 0) & (x_loc <= 1.0)
    smooth_out = np.exp(-((x_loc - 1.0)**2) / 0.25) * (x_loc > 1.0)
    
    smooth_env = smooth_in + smooth_body + smooth_out
    
    aoa_shift = -(particles_x - 0.25) * sin_aoa_full
    
    base_up = yc + yt + 0.03
    base_low = yc - yt - 0.03
    
    h_up = (base_up * cos_aoa + aoa_shift) * smooth_env
    h_low = (base_low * cos_aoa + aoa_shift) * smooth_env

    downwash_effect = -sin_aoa_full * 0.35 * (1.0 / (1.0 + np.exp(-5.0 * (particles_x - 0.5))))

    delta_y = np.zeros_like(particles_x)
    delta_y[upper_mask] = h_up[upper_mask] * np.exp(-1.5 * particles_y0[upper_mask])
    delta_y[~upper_mask] = h_low[~upper_mask] * np.exp(-1.5 * np.abs(particles_y0[~upper_mask]))
    
    particles_y = particles_y0 + delta_y + downwash_effect * dist_decay

    reset_cols = particles_x[:, 0] > 2.2
    if np.any(reset_cols):
        particles_x[reset_cols, :] = -0.8
            
    particles_scatter.set_offsets(np.column_stack([particles_x.flatten(), particles_y.flatten()]))
    particles_scatter.set_array(vx.flatten())
    
    return particles_scatter,

update_ui()
ani = animation.FuncAnimation(fig, animate, interval=33, blit=False)

