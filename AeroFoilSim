NUM_COLS = 20
PARTICLES_PER_COL = 30

y_rows = np.linspace(-1.1, 1.1, PARTICLES_PER_COL)
x_initial_cols = np.linspace(-0.8, 2.2, NUM_COLS, endpoint=False)

particles_x = np.zeros((NUM_COLS, PARTICLES_PER_COL))
for c in range(NUM_COLS):
    particles_x[c, :] = x_initial_cols[c]

particles_y0 = np.tile(y_rows, (NUM_COLS, 1))
particles_y = np.copy(particles_y0)

upper_mask = particles_y0 > 0
dist_decay = np.exp(-1.4 * np.abs(particles_y0))

def generate_naca_airfoil(camber_pct, thick_pct, num_points=100):
    m = camber_pct / 100.0
    p = 0.4
    t = max(0.01, thick_pct / 100.0)
    
    x = np.linspace(0, 1, num_points)
    yt = 5 * t * (0.2969 * np.sqrt(x) - 0.1260 * x - 0.3516 * x**2 + 0.2843 * x**3 - 0.1015 * x**4)
    
    yc = np.zeros_like(x)
    dyc_dx = np.zeros_like(x)
    for i, xi in enumerate(x):
        if xi < p:
            if p > 0:
                yc[i] = (m / p**2) * (2 * p * xi - xi**2)
                dyc_dx[i] = (2 * m / p**2) * (p - xi)
        else:
            if p < 1:
                yc[i] = (m / (1 - p)**2) * ((1 - 2 * p) + 2 * p * xi - xi**2)
                dyc_dx[i] = (2 * m / (1 - p)**2) * (p - xi)
                
    theta = np.arctan(dyc_dx)
    xu = x - yt * np.sin(theta)
    yu = yc + yt * np.cos(theta)
    xl = x + yt * np.sin(theta)
    yl = yc - yt * np.cos(theta)
    
    return np.concatenate([xu[::-1], xl[1:]]), np.concatenate([yu[::-1], yl[1:]])

def compute_physics(speed_kmh, alt_m, angle_deg, camber_pct, thick_pct, area_m2):
    rho = 1.225 * np.exp(-alt_m / 9200.0)
    v_ms = speed_kmh / 3.6
    q = 0.5 * rho * (v_ms**2)
    
    alpha_rad = np.radians(angle_deg)
    cl_0 = 2.0 * np.pi * (camber_pct / 100.0 * 2.0)
    cl = 2.0 * np.pi * alpha_rad + cl_0
    
    if angle_deg > 14:
        cl *= np.exp(-(angle_deg - 14) * 0.12)
    elif angle_deg < -10:
        cl *= np.exp((angle_deg + 10) * 0.12)
        
    cd_0 = 0.012 + 0.04 * (thick_pct / 100.0)
    cd_induced = (cl**2) / (np.pi * 6.0 * 0.85)
    cd = cd_0 + cd_induced
    
    lift = max(0.0, cl * q * area_m2)
    drag = max(0.1, cd * q * area_m2)
    return lift, drag, cl, cd

