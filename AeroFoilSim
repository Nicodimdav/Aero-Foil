    s.valtext.set_visible(False)

updating_flag = False

def update_ui(val=None):
    global updating_flag
    if updating_flag:
        return
    updating_flag = True
    
    speed, alt, angle = s_speed.val, s_alt.val, s_angle.val
    camber, thick, area = s_camber.val, s_thick.val, s_area.val
    
    tb_speed.set_val(f"{speed:.0f}")
    tb_alt.set_val(f"{alt:.0f}")
    tb_angle.set_val(f"{angle:.1f}")
    tb_camber.set_val(f"{camber:.1f}")
    tb_thick.set_val(f"{thick:.1f}")
    tb_area.set_val(f"{area:.0f}")
    
    updating_flag = False
    
    lift, drag, cl, cd = compute_physics(speed, alt, angle, camber, thick, area)
    
    x_foil, y_foil = generate_naca_airfoil(camber, thick)
    aoa_rad = np.radians(angle)
    cos_a, sin_a = np.cos(-aoa_rad), np.sin(-aoa_rad)
    rot = np.array([[cos_a, -sin_a], [sin_a, cos_a]])
    
    rotated = rot.dot(np.vstack((x_foil - 0.25, y_foil)))
    rx, ry = rotated[0] + 0.25, rotated[1]
    airfoil_patch.set_xy(np.column_stack([rx, ry]))
    
    ax_flow.set_title(f"Dynamic NACA Streamline Flow (AoA: {angle:.1f}° | Speed: {speed:.0f} km/h)", 
                      color='#0f172a', fontsize=12, fontweight='bold', pad=12)
    
    ax_out.clear()
    ax_out.set_facecolor('#f1f5f9')
    ax_out.axis('off')
    ax_out.text(0.05, 0.88, "FoilSim Outputs (SI)", fontsize=12, fontweight='bold', color='#0f172a')
    
    outputs = [
        ("Lift:", f"{int(lift):,} N".replace(',', ' ')),
        ("Drag:", f"{int(drag):,} N".replace(',', ' ')),
        ("CLift:", f"{cl:.4f}"),
        ("CDrag:", f"{cd:.4f}")
    ]
    
    y_pos = 0.68
    for label, val_str in outputs:
        ax_out.text(0.05, y_pos, label, fontsize=10, fontweight='bold', color='#334155')
        ax_out.text(0.42, y_pos - 0.02, f" {val_str} ", fontsize=10, fontweight='bold',
                    bbox=dict(boxstyle='round,pad=0.3', facecolor='#ffffff', edgecolor='#cbd5e1'))
        y_pos -= 0.18

    ax_bar.clear()
    ax_bar.set_facecolor('#ffffff')
    ax_bar.set_title("Force Comparison (N)", fontsize=10)
    ax_bar.bar(['Lift', 'Drag'], [lift, drag], color=['#0284c7', '#ef4444'], width=0.45)
    ax_bar.grid(axis='y', linestyle='--', alpha=0.5)

def make_tb_callback(slider, min_v, max_v):
    def callback(text):
        try:
            val = float(text)
            val = max(min_v, min(max_v, val))
            slider.set_val(val)
        except ValueError:
            pass
    return callback

